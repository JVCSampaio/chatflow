{
  "info": {
    "name": "ChatFlow API",
    "description": "Testes de API do ChatFlow: saúde, webchat, webhook do WhatsApp (assinatura HMAC e idempotência), atendimento humano e erros. Rode com o Newman: npm run test:postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "contratoWebchat",
      "value": "{\"type\":\"object\",\"required\":[\"duplicada\",\"conversa\",\"mensagens\"],\"additionalProperties\":false,\"properties\":{\"duplicada\":{\"type\":\"boolean\"},\"conversa\":{\"type\":\"object\",\"required\":[\"id\",\"canal\",\"contato\",\"status\",\"atendente\",\"transferencia\",\"criadaEm\",\"atualizadaEm\",\"encerradaEm\"],\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{24}$\"},\"canal\":{\"enum\":[\"whatsapp\",\"telegram\",\"webchat\"]},\"contato\":{\"type\":\"object\",\"required\":[\"id\",\"nome\"]},\"status\":{\"enum\":[\"bot\",\"aguardando\",\"em_atendimento\",\"encerrada\"]},\"atendente\":{\"type\":[\"string\",\"null\"]},\"transferencia\":{\"type\":[\"object\",\"null\"]},\"criadaEm\":{\"type\":\"string\"},\"atualizadaEm\":{\"type\":\"string\"},\"encerradaEm\":{\"type\":[\"string\",\"null\"]}}},\"mensagens\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"conversaId\",\"autor\",\"atendente\",\"texto\",\"criadaEm\"],\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{24}$\"},\"conversaId\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{24}$\"},\"autor\":{\"enum\":[\"cliente\",\"bot\",\"atendente\"]},\"atendente\":{\"type\":[\"string\",\"null\"]},\"texto\":{\"type\":\"string\"},\"criadaEm\":{\"type\":\"string\"}}}}}}"
    },
    {
      "key": "contratoConversa",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"canal\",\"contato\",\"status\",\"atendente\",\"transferencia\",\"criadaEm\",\"atualizadaEm\",\"encerradaEm\"],\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{24}$\"},\"canal\":{\"enum\":[\"whatsapp\",\"telegram\",\"webchat\"]},\"contato\":{\"type\":\"object\",\"required\":[\"id\",\"nome\"]},\"status\":{\"enum\":[\"bot\",\"aguardando\",\"em_atendimento\",\"encerrada\"]},\"atendente\":{\"type\":[\"string\",\"null\"]},\"transferencia\":{\"type\":[\"object\",\"null\"]},\"criadaEm\":{\"type\":\"string\"},\"atualizadaEm\":{\"type\":\"string\"},\"encerradaEm\":{\"type\":[\"string\",\"null\"]}}}"
    },
    {
      "key": "contratoErro",
      "value": "{\"type\":\"object\",\"required\":[\"erro\"],\"properties\":{\"erro\":{\"type\":\"string\",\"minLength\":1},\"detalhes\":{\"type\":\"array\"}}}"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Vale para todas as requisições: todo pedido recebe um id de correlação.",
          "pm.test('responde com X-Request-Id', () => pm.response.to.have.header('X-Request-Id'))"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Saúde e observabilidade",
      "description": "Disponibilidade do serviço e métricas no formato do Prometheus.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200))",
                  "pm.test('serviço e banco disponíveis', () => pm.expect(pm.response.json()).to.eql({ status: 'ok', banco: 'ok' }))",
                  "pm.test('responde em menos de 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500))"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Métricas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 em texto do Prometheus', () => {",
                  "  pm.response.to.have.status(200)",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain')",
                  "})",
                  "pm.test('expõe os contadores do atendimento', () => {",
                  "  const texto = pm.response.text()",
                  "  for (const nome of ['mensagens_recebidas_total', 'mensagens_duplicadas_total', 'transferencias_total', 'http_duracao_segundos']) {",
                  "    pm.expect(texto).to.include('# TYPE chatflow_' + nome)",
                  "  }",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Webchat: segunda via",
      "description": "Fluxo completo do bot pelo widget do site, do cumprimento ao encerramento.",
      "item": [
        {
          "name": "Cumprimento e menu",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sessao', pm.variables.replaceIn('{{$guid}}'))"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200))",
                  "pm.test('corpo segue o contrato', () => pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get('contratoWebchat'))))",
                  "const textosDoBot = pm.response.json().mensagens.filter((m) => m.autor === 'bot').map((m) => m.texto)",
                  "pm.test('bot cumprimenta e mostra o menu', () => {",
                  "  pm.expect(textosDoBot[0]).to.eql('Olá! Sou o assistente virtual do atendimento.')",
                  "  pm.expect(textosDoBot[1]).to.include('1 - Segunda via da fatura')",
                  "})",
                  "pm.collectionVariables.set('conversaWebchat', pm.response.json().conversa.id)"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessao\": \"{{sessao}}\",\n  \"texto\": \"oi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/webchat/mensagens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webchat",
                "mensagens"
              ]
            }
          }
        },
        {
          "name": "Opção 1: segunda via",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200))",
                  "const textosDoBot = pm.response.json().mensagens.filter((m) => m.autor === 'bot').map((m) => m.texto)",
                  "pm.test('bot pede o CPF', () => pm.expect(textosDoBot).to.eql(['Para enviar a segunda via, informe o CPF do titular.']))",
                  "pm.test('continua na mesma conversa', () => pm.expect(pm.response.json().conversa.id).to.eql(pm.collectionVariables.get('conversaWebchat')))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessao\": \"{{sessao}}\",\n  \"texto\": \"1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/webchat/mensagens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webchat",
                "mensagens"
              ]
            }
          }
        },
        {
          "name": "CPF com fatura em aberto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200))",
                  "const textosDoBot = pm.response.json().mensagens.filter((m) => m.autor === 'bot').map((m) => m.texto)",
                  "pm.test('envia a segunda via com o e-mail mascarado', () => {",
                  "  pm.expect(textosDoBot[0]).to.include('R$ 99,90')",
                  "  pm.expect(textosDoBot[0]).to.include('a***@example.com')",
                  "})",
                  "pm.test('o CPF volta mascarado (LGPD)', () => {",
                  "  const doCliente = pm.response.json().mensagens.find((m) => m.autor === 'cliente')",
                  "  pm.expect(doCliente.texto).to.eql('***.456.789-**')",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessao\": \"{{sessao}}\",\n  \"texto\": \"123.456.789-09\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/webchat/mensagens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webchat",
                "mensagens"
              ]
            }
          }
        },
        {
          "name": "Sair encerra a conversa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200))",
                  "pm.test('conversa encerrada', () => pm.expect(pm.response.json().conversa.status).to.eql('encerrada'))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
