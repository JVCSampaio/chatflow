            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessao\": \"{{sessao}}\",\n  \"texto\": \"sair\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/webchat/mensagens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webchat",
                "mensagens"
              ]
            }
          }
        },
        {
          "name": "Texto vazio é recusado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400))",
                  "pm.test('erro segue o contrato', () => pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get('contratoErro'))))",
                  "pm.test('indica o campo texto', () => {",
                  "  const corpo = pm.response.json()",
                  "  pm.expect(corpo.erro).to.eql('Dados inválidos.')",
                  "  pm.expect(corpo.detalhes.map((d) => d.campo)).to.include('texto')",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
